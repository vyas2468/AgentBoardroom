	avg_Generals_RelMom:	#Avg IF(InList("Generals") and momReady, relMom, NaN)
	// ================= LAYER 19: this symbol's own sector context ======
	// Plain selection over already-computed #Avg items. A breadth
	// operator is never placed inline here.
	mySectorRelMom:	if(SectorCodeRaw = 1, avg_Comms_RelMom,
		if(SectorCodeRaw = 2, avg_ConsumerDisc_RelMom,
		if(SectorCodeRaw = 3, avg_ConsStaples_RelMom,
		if(SectorCodeRaw = 4, avg_Energy_RelMom,
		if(SectorCodeRaw = 5, avg_Financials_RelMom,
		if(SectorCodeRaw = 6, avg_Healthcare_RelMom,
		if(SectorCodeRaw = 7, avg_Industrials_RelMom,
		if(SectorCodeRaw = 8, avg_ITSector_RelMom,
		if(SectorCodeRaw = 9, avg_Materials_RelMom,
		if(SectorCodeRaw = 10, avg_Utilities_RelMom,
		if(SectorCodeRaw = 11, avg_RealEstate_RelMom, NaN)))))))))))
	// ================================================================
	// ================= v4 LAYERS (appended, nothing above changed) ==
	// ================================================================
	// ---- LAYER 30: Alex DataView columns, computed for every symbol ----
	ret1:	IF(closev[1] > 0, 100 * (closev / closev[1] - 1), NaN)
	ret5:	IF(closev[5] > 0, 100 * (closev / closev[5] - 1), NaN)
	ret10:	IF(closev[10] > 0, 100 * (closev / closev[10] - 1), NaN)
	turnover:	closev * V
	turn20:	Avg(turnover, 20)
	histOK:	BarNum >= MinHistBars
	splitJump:	IF(closev[1] > 0, Abs(closev / closev[1] - 1) * 100 > SplitJumpPct, 0)
	splitRecent:	CountTrue(splitJump, 60) > 0
	badData:	IF(not histOK or splitRecent, 1, 0)
	eqTotal:	#Count IF(InList("AllEQ"), 1, NaN)
	eqAdv1:	#Count IF(InList("AllEQ") and histOK and ret1 > 0, 1, NaN)
	eqDec1:	#Count IF(InList("AllEQ") and histOK and ret1 < 0, 1, NaN)
	eqNet1:	NoNan(eqAdv1, 0) - NoNan(eqDec1, 0)
	etfTotal:	#Count IF(InList("ETF"), 1, NaN)
	etfAdv1:	#Count IF(InList("ETF") and histOK and ret1 > 0, 1, NaN)
	etfDec1:	#Count IF(InList("ETF") and histOK and ret1 < 0, 1, NaN)
	etfNet1:	NoNan(etfAdv1, 0) - NoNan(etfDec1, 0)
	// ---- LAYER 32: ETF rotation table (Recent, Previous, Delta, Direction) ----
	etfMomAvg:	#Avg IF(InList("ETF") and momReady, mom, NaN)
	etfRelMom:	IF(InList("ETF") and momReady, mom - etfMomAvg, NaN)

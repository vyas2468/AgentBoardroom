	StartDate:	2015-01-01
	EndDate:	Latest
	// Yahoo-only. Strips a symbol's newest bar ONLY if its own exchange
	// session had not completed at import time -- documented as safe to
	// leave on for pre-open runs. NOT plain True, which blindly strips
	// every symbol's latest bar whether complete or not.
	RemoveLatest:	Partial
	SaveAs:	C:\RealTest21_newerv2\Data\alexaligned_unified_v7.rtd


Settings:
	DataFile:	C:\RealTest21_newerv2\Data\alexaligned_unified_v7.rtd
	BarSize:	Daily
	EndDate:	Latest
	AccountSize:	100000
	UseAvailableBars:	False
	SaveScanAs:	?scriptpath?\AlexAligned_Unified_v7C_scan.csv

	// StartDate lives HERE and never in the shared Settings block above.
	// A StartDate in Settings corrupts the ScanSettings EndDate Latest
	// plus NumBars anchoring, which silently dumps the entire imported
	// history instead of the latest bar. Confirmed RealTest bug,
	// acknowledged by Marsten Parker 13.09.2026, fix due 2.0.32.8.
TestSettings:
	StartDate:	Earliest


Parameters:
	// === momentum horizons: his confirmed 5 / 20 / 60 day set ===
	MomShort:	from 3 to 20 step 1 def 5
	MomMed:	from 10 to 40 step 1 def 20
	MomLong:	from 40 to 120 step 5 def 60
	AccelLen:	from 5 to 60 step 5 def 21
	MoveLen:	from 5 to 20 step 1 def 10

	// === T-3 diff engine. DiffLen 3 is his confirmed window and should
	// not be changed casually -- every tag he publishes is a T-3 diff. ===
	DiffLen:	from 1 to 10 step 1 def 3
	SevCap:	100
	SevTrendW:	from 5 to 40 step 5 def 25
	SevDspW:	from 5 to 40 step 5 def 20
	SevCluW:	from 5 to 40 step 5 def 20
	SevCluDistW:	from 0 to 20 step 5 def 10
	SevStateW:	from 0 to 20 step 5 def 10
	SevRankW:	from 0 to 30 step 5 def 15
	SevBandW:	from 0 to 20 step 5 def 10
	SevPriceW:	from 0 to 20 step 5 def 10
	SevCandleW:	from 0 to 20 step 5 def 10
	SevRankScale:	from 0.2 to 3.0 step 0.1 def 1.0
	SevActThr:	from 5 to 50 step 5 def 20

	// === composite cross-sectional score weights. These are a
	// transparent deterministic blend, NOT a fitted model. ===
	WgtRelMom:	from 0 to 40 step 5 def 25
	WgtAccel:	from 0 to 40 step 5 def 20
	WgtMedMom:	from 0 to 40 step 5 def 15
	WgtStruct:	from 0 to 40 step 5 def 15
	WgtCluBal:	from 0 to 40 step 5 def 15
	WgtDsp:	from 0 to 40 step 5 def 10
	LongPctl:	from 60 to 95 step 5 def 80
	ShortPctl:	from 5 to 40 step 5 def 20
	BasketN:	from 5 to 30 step 1 def 10
	RankSpread:	from 0.0 to 1.5 step 0.1 def 0.6

	// === state classifier and attention thresholds. Calibrate before
	// trusting the labels -- none of these is reverse-engineered from a
	// screenshot, they are reasonable starting points. ===
	TrendRunMin:	from 3 to 40 step 1 def 10
	NearClustPct:	from 0.005 to 0.05 step 0.005 def 0.015
	// Lowered from v2.3's 0.5: the observed universe-wide abnScore max
	// was 0.5293, so 0.5 was very nearly unreachable.
	AbnScoreHi:	from 0.1 to 1.0 step 0.05 def 0.35
	// Coherence now reads the RANK-2 cycle's relative power. The old
	// rank-1 relPower is 1.0 by construction and measured nothing.
	Rank2DomMax:	from 0.2 to 0.95 step 0.05 def 0.60
	MoverPctl:	from 70 to 98 step 2 def 90
	AnomHiPctl:	from 60 to 95 step 5 def 80
	WeakCloseMax:	from 0.2 to 0.5 step 0.05 def 0.35
	RunLook:	500

	// === case 232 StepMA V3.5.2 plus Alex bands ===
	StepMA_MinLen:	from 4 to 20 step 1 def 8
	StepMA_MaxLen:	from 20 to 100 step 5 def 40
	StepMA_BandK:	from 1.0 to 4.0 step 0.1 def 2.2
	// 3, not v2.3's 2: at 2 the ring-3 outputs return NaN on every bar,
	// which is why BandUp3 and BandLo3 were dead in the 18.09.2026 run.
	StepMA_BandCount:	2, 3 def 3
	StepMA_AbnMode:	1, 3 def 1
	StepMA_AE_Latent:	1, 2, 3 def 2
	StepMA_AE_Decay:	from 0.90 to 0.99 step 0.01 def 0.97
	StepMA_AE_Refresh:	from 1 to 20 step 1 def 5

	// === FIR band instance 1, slow. His DSP long term average. ===
	FIRBand_CycleUpperBound:	from 60 to 200 step 10 def 120
	FIRBand_FilterType:	1, 2, 3, 4, 5, 6, 7 def 1
	FIRBand_AnalysisBars:	from 200 to 500 step 20 def 360

	// === FIR band instance 2, fast. The short cycle read. ===
	FIRBand2_CycleLowerBound:	from 5 to 20 step 1 def 8
	FIRBand2_CycleUpperBound:	from 20 to 80 step 5 def 45
	FIRBand2_AnalysisBars:	from 60 to 250 step 10 def 130
	FIRBand2_AROrder:	from 20 to 100 step 5 def 60
	FIRBand2_FilterType:	1, 2, 3, 4, 5, 6, 7 def 1

	// === case 233 RMESA Burg spectrum ===
	RMESA_AnalysisBars:	from 100 to 400 step 20 def 200
	RMESA_AROrder:	from 30 to 150 step 10 def 150
	RMESA_MaxPeriod:	from 60 to 200 step 10 def 120

	// === case 237 KalmanEO ===
	KEO_QRatio:	from 0.005 to 0.20 step 0.005 def 0.05
	KEO_OscMode:	1, 2, 3 def 1
	KEO_VMaxMult:	from 1.0 to 10.0 step 0.5 def 3.0

	// === DVCWP v3.5.0 cases 244 and 247. Values verbatim from the
	// production DVCWP350_QQQ_Daily config, matching the live MC chart.
	// Args 3 through 45 MUST be identical for 244 and 247 -- differing
	// core args silently desynchronise the two cluster histories. ===
	PriceSrc:	6
	ClustSize:	6
	WinSize:	12
	Lookback:	39
	DecayF:	0.98
	NumClust:	30
	MergeMult:	1.0
	MinTick:	0.0
	PersistLock:	1
	VolAdaptM:	1
	VolAdaptShortLen:	12
	VolAdaptBlend:	0.15
	VolAdaptHoldBnds:	3
	VolAdaptLookMin:	20
	VolAdaptLookMax:	80
	VolAdaptDecMin:	0.90
	VolAdaptDecMax:	0.995
	AdaptSizeM:	1
	AdaptBasisM:	3
	AdaptWarmup:	250
	AdaptClustMin:	3
	AdaptClustMax:	60
	AdaptWinMin:	4
	AdaptWinMax:	120
	AdaptLookMin:	15
	AdaptLookMax:	600
	AdaptStepHold:	4
	AdaptStepMove:	1
	MergeWMaxMult:	2.0
	DecayModelM:	1
	DecayRpMinT:	20
	DecayRpMaxSh:	0.7
	DirBiasTopN:	30
	RegLookback:	1000
	RegTouchBand:	0.40
	RegCrossBand:	0.0
	RegScanEvery:	1
	RegMR:	2.5
	RegBO:	1.3
	RegMinCross:	8
	RegLowTouch:	300
	RegForceScan:	60
	ShowRegime:	1
	TopNClusters:	8
	// --- case 247 follow-line tail. FollowMode 0 is PL's frozen default.
	FollowAnchor:	0
	FollowMode:	0
	FollowCont:	0
	FollowMaxBars:	120
	FollowEMA:	0.20
	SMlegacyE:	0
	SMfilter:	2.0
	SMcycles:	4.0
	SMminLen:	8
	SMmaxLen:	40
	SMvolMult:	2.5
	SMflip:	1.6
	SMevDecay:	0.85
	SMflatLam:	1.25
	SMflatConf:	0.65
	SMshape:	1
	SMshapeCap:	0.35
	SMwarmup:	50


	// === Master Basket Strategy additive layer (23.09.2026) ===
	BBMode:	1, 2 def 1
	BasketBN:	from 3 to 25 step 1 def 10
	BBSectorCap:	from 1 to 10 step 1 def 3
	CGBasketN:	from 3 to 20 step 1 def 8
	NGBasketN:	from 3 to 20 step 1 def 8
	CorrWindow:	from 20 to 120 step 1 def 63
	CorrThreshold:	from 0.3 to 0.95 step 0.05 def 0.75

	// === Sleeve capital allocation and exposure discipline (23.09.2026) ===
	// Every Alloc below is a percent of TOTAL account equity that the sleeve may
	// have invested at most. Position size and the sleeve MaxExposure are both
	// derived from it, so a sleeve can never exceed its own allocation. Run one
	// sleeve on its own at 100. To run several together make the ones you enable
	// sum to 100 or less; the Combined block enforces a hard 100 in any case.
	MBAlloc:	100
	BBAlloc:	100
	CGAlloc:	100
	NGAlloc:	100
	// Size positions to (100 - ExpBuffer) percent of the sleeve allocation. Orders
	// are sized at the signal close but fill at the next open, so a gap up costs
	// more than was budgeted; the buffer absorbs that so cash cannot go negative.
	ExpBuffer:	from 0 to 10 step 1 def 3
	MBPositions:	from 3 to 30 step 1 def 20
	// === v2 rebalance / turnover controls (23.09.2026) ===
	// RebalMode 0 = every day (exactly v1 behaviour), 1 = weekly, 2 = monthly. On a
	// rebalance day only, entries are allowed and exits are allowed. Between
	// rebalance days the book is frozen.
	RebalMode:	from 0 to 2 step 1 def 1
	// 1 = new entries only on rebalance days, 0 = fill any free slot daily.
	MBEntryOnRebal:	0, 1 def 1
	// Exit hysteresis: a held name is kept while it is still in the Master union OR its
	// composite percentile is still at or above MBHoldPctl. 101 switches the buffer off (v1).
	MBHoldPctl:	from 40 to 101 step 5 def 60
	// Minimum bars held before any exit is considered.
	MBMinHold:	from 0 to 40 step 1 def 0
	// Minimum number of the 3 methods that must agree for a name to be a candidate. 1 = v1.
	MBMinAgree:	from 1 to 3 step 1 def 1
	// Slippage per fill, percent of fill price. 0 = v1. Try 0.05 to 0.10 for a realistic read.
	SlipPct:	from 0 to 0.5 step 0.05 def 0
	// ================= v4 parameters =================
	MinHistBars:	252
	SplitJumpPct:	35
	DirBand:	15
	MASTopN:	600
	GraphHiPct:	0.30
	VolWin:	252
	CorrShort:	20
	CorrMid:	60
	CorrLong:	120


Data:
	// ================= LAYER 0: raw price =================
	closev:	C
	openv:	O
	highv:	H
	lowv:	L
	// ================= LAYER 0b: sector membership =================
	// Defined up here, not further down, because the per-sector
	// selectors in the attention and composite layers reference it and
	// Data items are evaluated strictly in definition order.
	SectorCodeRaw:	IF(InList("Comms"), 1,
		IF(InList("ConsumerDisc"), 2,
		IF(InList("ConsStaples"), 3,
		IF(InList("Energy"), 4,
		IF(InList("Financials"), 5,
		IF(InList("Healthcare"), 6,
		IF(InList("Industrials"), 7,
		IF(InList("ITSector"), 8,
		IF(InList("Materials"), 9,
		IF(InList("Utilities"), 10,
		IF(InList("RealEstate"), 11,
		IF(InList("Benchmark"), 12,
		IF(InList("ETF"), 13, 0)))))))))))))
	momReady:	closev[MomLong + AccelLen] > 0
	diffReady:	momReady and closev[MomLong + AccelLen + DiffLen] > 0
	// ================= LAYER 3: multi-horizon momentum =================
	// 5 / 20 / 60 are his confirmed horizons.
	momS:	IF(momReady, closev / closev[MomShort] - 1, NaN)
	momM:	IF(momReady, closev / closev[MomMed] - 1, NaN)
	mom:	IF(momReady, closev / closev[MomLong] - 1, NaN)
	momAccel:	IF(momReady, mom - mom[AccelLen], NaN)
	moveAbs:	IF(momReady, Abs(closev / closev[MoveLen] - 1), NaN)
	// Breadth ops must be the WHOLE formula of their own item -- they
	// can never be nested inside IF() or arithmetic. Everything derived
	// from them below is plain arithmetic referencing the named item.
	momUniverseAvg:	#Avg IF(InList("AllEQ") and momReady, mom, NaN)
	relMom:	IF(momReady, mom - momUniverseAvg, NaN)
	relMomRank:	#Rank IF(InList("AllEQ") and momReady, relMom, NaN)
	relMomPctl:	#PercentRank IF(InList("AllEQ") and momReady, relMom, NaN)
	accelRank:	#Rank IF(InList("AllEQ") and momReady, momAccel, NaN)
	accelPctl:	#PercentRank IF(InList("AllEQ") and momReady, momAccel, NaN)
	movePctl:	#PercentRank IF(InList("AllEQ") and momReady, moveAbs, NaN)
	// ================= LAYER 10: pure-OHLC 3-day micro features ========
	// These back his INTRADAY_SELLING_3D, BEARISH_CANDLE_BREADTH_3D and
	// WEAK_CLOSE_LOCATION_3D tags. Close Location Value is where the
	// close sits inside the bar's own range: 1 at the high, 0 at the low.
	// No indicator library involved, just OHLC.
	barRange:	highv - lowv
	clv:	IF(barRange > 0, (closev - lowv) / barRange, 0.5)
	clv3:	(clv + clv[1] + clv[2]) / 3
	bearCandle:	closev < openv
	bearCandle3:	bearCandle + bearCandle[1] + bearCandle[2]
	weakClose3:	clv3 <= WeakCloseMax
	intradaySell3:	clv3 <= WeakCloseMax and bearCandle3 >= 2
	decline3:	momReady and closev < closev[3]
	decline5:	momReady and closev < closev[5]
	advance3:	momReady and closev > closev[3]
	PriceTagCode:	IF(momReady and decline5 = 1 and decline3 = 1, 1,
		IF(momReady and decline3 = 1, 2,
		IF(momReady and advance3 = 1, 3, 0)))
	CandleTagCode:	IF(intradaySell3 = 1, 1,
		IF(bearCandle3 >= 2, 2,
		IF(weakClose3 = 1, 3, 0)))
	// Rank 1 is the STRONGEST in RealTest, so a falling rank number is
	// an improvement. The sign here is deliberate, not a transcription
	// slip.
	rankDelta:	IF(diffReady and momReady and not IsNaN(relMomRank) and not IsNaN(relMomRank[DiffLen]), relMomRank[DiffLen] - relMomRank, NaN)
	sevRank:	IF(IsNaN(rankDelta), 0, Max(0 - SevRankW, Min(SevRankW, rankDelta * SevRankScale)))
	sevPrice:	IF(momReady,
		IF(advance3 = 1, SevPriceW, IF(decline3 = 1, 0 - SevPriceW, 0)), 0)
	sevCandle:	IF(intradaySell3 = 1, 0 - SevCandleW,
		IF(weakClose3 = 1, 0 - SevCandleW / 2, IF(clv3 >= 0.65, SevCandleW / 2, 0)))
	attnM:	IF(momReady and not IsNaN(movePctl), movePctl >= MoverPctl, 0)
	// ================= LAYER 17: breadth condition flags =================
	// NaN, not 0, while unready -- so an unwarmed symbol is silently
	// EXCLUDED from every #Count rather than miscounted as a false.
	momPos:	IF(momReady, mom > 0, NaN)
	accelPos:	IF(momReady, momAccel > 0, NaN)
	relMomPos:	IF(momReady, relMom > 0, NaN)
	cnt_Comms_TotMom:	#Count IF(InList("Comms") and momReady, 1, NaN)
	cnt_Comms_MomP:	#Count IF(InList("Comms") and momPos = 1, 1, NaN)
	cnt_Comms_MomN:	#Count IF(InList("Comms") and momPos = 0, 1, NaN)
	brd_Comms_Mom:	100 * (NoNan(cnt_Comms_MomP, 0) - NoNan(cnt_Comms_MomN, 0)) / Max(1, NoNan(cnt_Comms_TotMom, 0))
	cnt_Comms_AccelP:	#Count IF(InList("Comms") and accelPos = 1, 1, NaN)
	cnt_Comms_AccelN:	#Count IF(InList("Comms") and accelPos = 0, 1, NaN)
	brd_Comms_Accel:	100 * (NoNan(cnt_Comms_AccelP, 0) - NoNan(cnt_Comms_AccelN, 0)) / Max(1, NoNan(cnt_Comms_TotMom, 0))
	cnt_Comms_RelMomP:	#Count IF(InList("Comms") and relMomPos = 1, 1, NaN)
	cnt_Comms_RelMomN:	#Count IF(InList("Comms") and relMomPos = 0, 1, NaN)
	brd_Comms_RelMom:	100 * (NoNan(cnt_Comms_RelMomP, 0) - NoNan(cnt_Comms_RelMomN, 0)) / Max(1, NoNan(cnt_Comms_TotMom, 0))
	avg_Comms_RelMom:	#Avg IF(InList("Comms") and momReady, relMom, NaN)
	cnt_ConsumerDisc_TotMom:	#Count IF(InList("ConsumerDisc") and momReady, 1, NaN)
	cnt_ConsumerDisc_MomP:	#Count IF(InList("ConsumerDisc") and momPos = 1, 1, NaN)
	cnt_ConsumerDisc_MomN:	#Count IF(InList("ConsumerDisc") and momPos = 0, 1, NaN)
	brd_ConsumerDisc_Mom:	100 * (NoNan(cnt_ConsumerDisc_MomP, 0) - NoNan(cnt_ConsumerDisc_MomN, 0)) / Max(1, NoNan(cnt_ConsumerDisc_TotMom, 0))
	cnt_ConsumerDisc_AccelP:	#Count IF(InList("ConsumerDisc") and accelPos = 1, 1, NaN)
	cnt_ConsumerDisc_AccelN:	#Count IF(InList("ConsumerDisc") and accelPos = 0, 1, NaN)
	brd_ConsumerDisc_Accel:	100 * (NoNan(cnt_ConsumerDisc_AccelP, 0) - NoNan(cnt_ConsumerDisc_AccelN, 0)) / Max(1, NoNan(cnt_ConsumerDisc_TotMom, 0))
	cnt_ConsumerDisc_RelMomP:	#Count IF(InList("ConsumerDisc") and relMomPos = 1, 1, NaN)
	cnt_ConsumerDisc_RelMomN:	#Count IF(InList("ConsumerDisc") and relMomPos = 0, 1, NaN)
	brd_ConsumerDisc_RelMom:	100 * (NoNan(cnt_ConsumerDisc_RelMomP, 0) - NoNan(cnt_ConsumerDisc_RelMomN, 0)) / Max(1, NoNan(cnt_ConsumerDisc_TotMom, 0))
	avg_ConsumerDisc_RelMom:	#Avg IF(InList("ConsumerDisc") and momReady, relMom, NaN)
	cnt_ConsStaples_TotMom:	#Count IF(InList("ConsStaples") and momReady, 1, NaN)
	cnt_ConsStaples_MomP:	#Count IF(InList("ConsStaples") and momPos = 1, 1, NaN)
	cnt_ConsStaples_MomN:	#Count IF(InList("ConsStaples") and momPos = 0, 1, NaN)
	brd_ConsStaples_Mom:	100 * (NoNan(cnt_ConsStaples_MomP, 0) - NoNan(cnt_ConsStaples_MomN, 0)) / Max(1, NoNan(cnt_ConsStaples_TotMom, 0))
	cnt_ConsStaples_AccelP:	#Count IF(InList("ConsStaples") and accelPos = 1, 1, NaN)
	cnt_ConsStaples_AccelN:	#Count IF(InList("ConsStaples") and accelPos = 0, 1, NaN)
	brd_ConsStaples_Accel:	100 * (NoNan(cnt_ConsStaples_AccelP, 0) - NoNan(cnt_ConsStaples_AccelN, 0)) / Max(1, NoNan(cnt_ConsStaples_TotMom, 0))
	cnt_ConsStaples_RelMomP:	#Count IF(InList("ConsStaples") and relMomPos = 1, 1, NaN)
	cnt_ConsStaples_RelMomN:	#Count IF(InList("ConsStaples") and relMomPos = 0, 1, NaN)
	brd_ConsStaples_RelMom:	100 * (NoNan(cnt_ConsStaples_RelMomP, 0) - NoNan(cnt_ConsStaples_RelMomN, 0)) / Max(1, NoNan(cnt_ConsStaples_TotMom, 0))
	avg_ConsStaples_RelMom:	#Avg IF(InList("ConsStaples") and momReady, relMom, NaN)
	cnt_Energy_TotMom:	#Count IF(InList("Energy") and momReady, 1, NaN)
	cnt_Energy_MomP:	#Count IF(InList("Energy") and momPos = 1, 1, NaN)
	cnt_Energy_MomN:	#Count IF(InList("Energy") and momPos = 0, 1, NaN)
	brd_Energy_Mom:	100 * (NoNan(cnt_Energy_MomP, 0) - NoNan(cnt_Energy_MomN, 0)) / Max(1, NoNan(cnt_Energy_TotMom, 0))
	cnt_Energy_AccelP:	#Count IF(InList("Energy") and accelPos = 1, 1, NaN)
	cnt_Energy_AccelN:	#Count IF(InList("Energy") and accelPos = 0, 1, NaN)
	brd_Energy_Accel:	100 * (NoNan(cnt_Energy_AccelP, 0) - NoNan(cnt_Energy_AccelN, 0)) / Max(1, NoNan(cnt_Energy_TotMom, 0))
	cnt_Energy_RelMomP:	#Count IF(InList("Energy") and relMomPos = 1, 1, NaN)
	cnt_Energy_RelMomN:	#Count IF(InList("Energy") and relMomPos = 0, 1, NaN)
	brd_Energy_RelMom:	100 * (NoNan(cnt_Energy_RelMomP, 0) - NoNan(cnt_Energy_RelMomN, 0)) / Max(1, NoNan(cnt_Energy_TotMom, 0))
	avg_Energy_RelMom:	#Avg IF(InList("Energy") and momReady, relMom, NaN)
	cnt_Financials_TotMom:	#Count IF(InList("Financials") and momReady, 1, NaN)
	cnt_Financials_MomP:	#Count IF(InList("Financials") and momPos = 1, 1, NaN)
	cnt_Financials_MomN:	#Count IF(InList("Financials") and momPos = 0, 1, NaN)
	brd_Financials_Mom:	100 * (NoNan(cnt_Financials_MomP, 0) - NoNan(cnt_Financials_MomN, 0)) / Max(1, NoNan(cnt_Financials_TotMom, 0))
	cnt_Financials_AccelP:	#Count IF(InList("Financials") and accelPos = 1, 1, NaN)
	cnt_Financials_AccelN:	#Count IF(InList("Financials") and accelPos = 0, 1, NaN)
	brd_Financials_Accel:	100 * (NoNan(cnt_Financials_AccelP, 0) - NoNan(cnt_Financials_AccelN, 0)) / Max(1, NoNan(cnt_Financials_TotMom, 0))
	cnt_Financials_RelMomP:	#Count IF(InList("Financials") and relMomPos = 1, 1, NaN)
	cnt_Financials_RelMomN:	#Count IF(InList("Financials") and relMomPos = 0, 1, NaN)
	brd_Financials_RelMom:	100 * (NoNan(cnt_Financials_RelMomP, 0) - NoNan(cnt_Financials_RelMomN, 0)) / Max(1, NoNan(cnt_Financials_TotMom, 0))
	avg_Financials_RelMom:	#Avg IF(InList("Financials") and momReady, relMom, NaN)
	cnt_Healthcare_TotMom:	#Count IF(InList("Healthcare") and momReady, 1, NaN)
	cnt_Healthcare_MomP:	#Count IF(InList("Healthcare") and momPos = 1, 1, NaN)
	cnt_Healthcare_MomN:	#Count IF(InList("Healthcare") and momPos = 0, 1, NaN)
	brd_Healthcare_Mom:	100 * (NoNan(cnt_Healthcare_MomP, 0) - NoNan(cnt_Healthcare_MomN, 0)) / Max(1, NoNan(cnt_Healthcare_TotMom, 0))
	cnt_Healthcare_AccelP:	#Count IF(InList("Healthcare") and accelPos = 1, 1, NaN)
	cnt_Healthcare_AccelN:	#Count IF(InList("Healthcare") and accelPos = 0, 1, NaN)
	brd_Healthcare_Accel:	100 * (NoNan(cnt_Healthcare_AccelP, 0) - NoNan(cnt_Healthcare_AccelN, 0)) / Max(1, NoNan(cnt_Healthcare_TotMom, 0))
	cnt_Healthcare_RelMomP:	#Count IF(InList("Healthcare") and relMomPos = 1, 1, NaN)
	cnt_Healthcare_RelMomN:	#Count IF(InList("Healthcare") and relMomPos = 0, 1, NaN)
	brd_Healthcare_RelMom:	100 * (NoNan(cnt_Healthcare_RelMomP, 0) - NoNan(cnt_Healthcare_RelMomN, 0)) / Max(1, NoNan(cnt_Healthcare_TotMom, 0))
	avg_Healthcare_RelMom:	#Avg IF(InList("Healthcare") and momReady, relMom, NaN)
	cnt_Industrials_TotMom:	#Count IF(InList("Industrials") and momReady, 1, NaN)
	cnt_Industrials_MomP:	#Count IF(InList("Industrials") and momPos = 1, 1, NaN)
	cnt_Industrials_MomN:	#Count IF(InList("Industrials") and momPos = 0, 1, NaN)
	brd_Industrials_Mom:	100 * (NoNan(cnt_Industrials_MomP, 0) - NoNan(cnt_Industrials_MomN, 0)) / Max(1, NoNan(cnt_Industrials_TotMom, 0))
	cnt_Industrials_AccelP:	#Count IF(InList("Industrials") and accelPos = 1, 1, NaN)
	cnt_Industrials_AccelN:	#Count IF(InList("Industrials") and accelPos = 0, 1, NaN)
	brd_Industrials_Accel:	100 * (NoNan(cnt_Industrials_AccelP, 0) - NoNan(cnt_Industrials_AccelN, 0)) / Max(1, NoNan(cnt_Industrials_TotMom, 0))
	cnt_Industrials_RelMomP:	#Count IF(InList("Industrials") and relMomPos = 1, 1, NaN)
	cnt_Industrials_RelMomN:	#Count IF(InList("Industrials") and relMomPos = 0, 1, NaN)
	brd_Industrials_RelMom:	100 * (NoNan(cnt_Industrials_RelMomP, 0) - NoNan(cnt_Industrials_RelMomN, 0)) / Max(1, NoNan(cnt_Industrials_TotMom, 0))
	avg_Industrials_RelMom:	#Avg IF(InList("Industrials") and momReady, relMom, NaN)
	cnt_ITSector_TotMom:	#Count IF(InList("ITSector") and momReady, 1, NaN)
	cnt_ITSector_MomP:	#Count IF(InList("ITSector") and momPos = 1, 1, NaN)
	cnt_ITSector_MomN:	#Count IF(InList("ITSector") and momPos = 0, 1, NaN)
	brd_ITSector_Mom:	100 * (NoNan(cnt_ITSector_MomP, 0) - NoNan(cnt_ITSector_MomN, 0)) / Max(1, NoNan(cnt_ITSector_TotMom, 0))
	cnt_ITSector_AccelP:	#Count IF(InList("ITSector") and accelPos = 1, 1, NaN)
	cnt_ITSector_AccelN:	#Count IF(InList("ITSector") and accelPos = 0, 1, NaN)
	brd_ITSector_Accel:	100 * (NoNan(cnt_ITSector_AccelP, 0) - NoNan(cnt_ITSector_AccelN, 0)) / Max(1, NoNan(cnt_ITSector_TotMom, 0))
	cnt_ITSector_RelMomP:	#Count IF(InList("ITSector") and relMomPos = 1, 1, NaN)
	cnt_ITSector_RelMomN:	#Count IF(InList("ITSector") and relMomPos = 0, 1, NaN)
	brd_ITSector_RelMom:	100 * (NoNan(cnt_ITSector_RelMomP, 0) - NoNan(cnt_ITSector_RelMomN, 0)) / Max(1, NoNan(cnt_ITSector_TotMom, 0))
	avg_ITSector_RelMom:	#Avg IF(InList("ITSector") and momReady, relMom, NaN)
	cnt_Materials_TotMom:	#Count IF(InList("Materials") and momReady, 1, NaN)
	cnt_Materials_MomP:	#Count IF(InList("Materials") and momPos = 1, 1, NaN)
	cnt_Materials_MomN:	#Count IF(InList("Materials") and momPos = 0, 1, NaN)
	brd_Materials_Mom:	100 * (NoNan(cnt_Materials_MomP, 0) - NoNan(cnt_Materials_MomN, 0)) / Max(1, NoNan(cnt_Materials_TotMom, 0))
	cnt_Materials_AccelP:	#Count IF(InList("Materials") and accelPos = 1, 1, NaN)
	cnt_Materials_AccelN:	#Count IF(InList("Materials") and accelPos = 0, 1, NaN)
	brd_Materials_Accel:	100 * (NoNan(cnt_Materials_AccelP, 0) - NoNan(cnt_Materials_AccelN, 0)) / Max(1, NoNan(cnt_Materials_TotMom, 0))
	cnt_Materials_RelMomP:	#Count IF(InList("Materials") and relMomPos = 1, 1, NaN)
	cnt_Materials_RelMomN:	#Count IF(InList("Materials") and relMomPos = 0, 1, NaN)
	brd_Materials_RelMom:	100 * (NoNan(cnt_Materials_RelMomP, 0) - NoNan(cnt_Materials_RelMomN, 0)) / Max(1, NoNan(cnt_Materials_TotMom, 0))
	avg_Materials_RelMom:	#Avg IF(InList("Materials") and momReady, relMom, NaN)
	cnt_Utilities_TotMom:	#Count IF(InList("Utilities") and momReady, 1, NaN)
	cnt_Utilities_MomP:	#Count IF(InList("Utilities") and momPos = 1, 1, NaN)
	cnt_Utilities_MomN:	#Count IF(InList("Utilities") and momPos = 0, 1, NaN)
	brd_Utilities_Mom:	100 * (NoNan(cnt_Utilities_MomP, 0) - NoNan(cnt_Utilities_MomN, 0)) / Max(1, NoNan(cnt_Utilities_TotMom, 0))
	cnt_Utilities_AccelP:	#Count IF(InList("Utilities") and accelPos = 1, 1, NaN)
	cnt_Utilities_AccelN:	#Count IF(InList("Utilities") and accelPos = 0, 1, NaN)

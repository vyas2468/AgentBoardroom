, indN_FoodDistribution, IF(indCode = 98, indN_Gold, IF(indCode = 99, indN_GroceryStores, IF(indCode = 100, indN_HealthInformationService, IF(indCode = 101, indN_InsuranceReinsurance, IF(indCode = 102, indN_Leisure, IF(indCode = 103, indN_LuxuryGoods, IF(indCode = 104, indN_PersonalServices, IF(indCode = 105, indN_PollutionTreatmentContro, IF(indCode = 106, indN_ReitDiversified, IF(indCode = 107, indN_ReitHotelMotel, IF(indCode = 108, indN_RentalLeasingServices, IF(indCode = 109, indN_SecurityProtectionServic, IF(indCode = 110, indN_Solar, IF(indCode = 111, indN_Trucking, IF(indCode = 112, indN_UtilitiesRegulatedWater, NaN))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
	// ---- LAYER 36: ROTATION MOTION, the Rotation tab quadrant done inside RealTest ----
	// The terminal plots each sector at X = level of relative momentum and Y = median T-3 severity,
	// and a baseline shows where it has MOVED. Here the baseline is simply N bars ago on the same series.
	// Both axes are turned into 0..100 ranks AMONG THE 11 SECTORS so that X and Y are comparable and
	// distance moved means something. Motion is then computed on the OWN sector only, then ranked
	// against the other ten sectors. Sector items repeat on every member row, as with avg_ and med_.
	xr_Comms:	100 * (IF(avg_ConsumerDisc_RelMom < avg_Comms_RelMom, 1, 0) + IF(avg_ConsStaples_RelMom < avg_Comms_RelMom, 1, 0) + IF(avg_Energy_RelMom < avg_Comms_RelMom, 1, 0) + IF(avg_Financials_RelMom < avg_Comms_RelMom, 1, 0) + IF(avg_Healthcare_RelMom < avg_Comms_RelMom, 1, 0) + IF(avg_Industrials_RelMom < avg_Comms_RelMom, 1, 0) + IF(avg_ITSector_RelMom < avg_Comms_RelMom, 1, 0) + IF(avg_Materials_RelMom < avg_Comms_RelMom, 1, 0) + IF(avg_Utilities_RelMom < avg_Comms_RelMom, 1, 0) + IF(avg_RealEstate_RelMom < avg_Comms_RelMom, 1, 0)) / 10
	xr_ConsumerDisc:	100 * (IF(avg_Comms_RelMom < avg_ConsumerDisc_RelMom, 1, 0) + IF(avg_ConsStaples_RelMom < avg_ConsumerDisc_RelMom, 1, 0) + IF(avg_Energy_RelMom < avg_ConsumerDisc_RelMom, 1, 0) + IF(avg_Financials_RelMom < avg_ConsumerDisc_RelMom, 1, 0) + IF(avg_Healthcare_RelMom < avg_ConsumerDisc_RelMom, 1, 0) + IF(avg_Industrials_RelMom < avg_ConsumerDisc_RelMom, 1, 0) + IF(avg_ITSector_RelMom < avg_ConsumerDisc_RelMom, 1, 0) + IF(avg_Materials_RelMom < avg_ConsumerDisc_RelMom, 1, 0) + IF(avg_Utilities_RelMom < avg_ConsumerDisc_RelMom, 1, 0) + IF(avg_RealEstate_RelMom < avg_ConsumerDisc_RelMom, 1, 0)) / 10
	xr_ConsStaples:	100 * (IF(avg_Comms_RelMom < avg_ConsStaples_RelMom, 1, 0) + IF(avg_ConsumerDisc_RelMom < avg_ConsStaples_RelMom, 1, 0) + IF(avg_Energy_RelMom < avg_ConsStaples_RelMom, 1, 0) + IF(avg_Financials_RelMom < avg_ConsStaples_RelMom, 1, 0) + IF(avg_Healthcare_RelMom < avg_ConsStaples_RelMom, 1, 0) + IF(avg_Industrials_RelMom < avg_ConsStaples_RelMom, 1, 0) + IF(avg_ITSector_RelMom < avg_ConsStaples_RelMom, 1, 0) + IF(avg_Materials_RelMom < avg_ConsStaples_RelMom, 1, 0) + IF(avg_Utilities_RelMom < avg_ConsStaples_RelMom, 1, 0) + IF(avg_RealEstate_RelMom < avg_ConsStaples_RelMom, 1, 0)) / 10
	xr_Energy:	100 * (IF(avg_Comms_RelMom < avg_Energy_RelMom, 1, 0) + IF(avg_ConsumerDisc_RelMom < avg_Energy_RelMom, 1, 0) + IF(avg_ConsStaples_RelMom < avg_Energy_RelMom, 1, 0) + IF(avg_Financials_RelMom < avg_Energy_RelMom, 1, 0) + IF(avg_Healthcare_RelMom < avg_Energy_RelMom, 1, 0) + IF(avg_Industrials_RelMom < avg_Energy_RelMom, 1, 0) + IF(avg_ITSector_RelMom < avg_Energy_RelMom, 1, 0) + IF(avg_Materials_RelMom < avg_Energy_RelMom, 1, 0) + IF(avg_Utilities_RelMom < avg_Energy_RelMom, 1, 0) + IF(avg_RealEstate_RelMom < avg_Energy_RelMom, 1, 0)) / 10
	xr_Financials:	100 * (IF(avg_Comms_RelMom < avg_Financials_RelMom, 1, 0) + IF(avg_ConsumerDisc_RelMom < avg_Financials_RelMom, 1, 0) + IF(avg_ConsStaples_RelMom < avg_Financials_RelMom, 1, 0) + IF(avg_Energy_RelMom < avg_Financials_RelMom, 1, 0) + IF(avg_Healthcare_RelMom < avg_Financials_RelMom, 1, 0) + IF(avg_Industrials_RelMom < avg_Financials_RelMom, 1, 0) + IF(avg_ITSector_RelMom < avg_Financials_RelMom, 1, 0) + IF(avg_Materials_RelMom < avg_Financials_RelMom, 1, 0) + IF(avg_Utilities_RelMom < avg_Financials_RelMom, 1, 0) + IF(avg_RealEstate_RelMom < avg_Financials_RelMom, 1, 0)) / 10
	xr_Healthcare:	100 * (IF(avg_Comms_RelMom < avg_Healthcare_RelMom, 1, 0) + IF(avg_ConsumerDisc_RelMom < avg_Healthcare_RelMom, 1, 0) + IF(avg_ConsStaples_RelMom < avg_Healthcare_RelMom, 1, 0) + IF(avg_Energy_RelMom < avg_Healthcare_RelMom, 1, 0) + IF(avg_Financials_RelMom < avg_Healthcare_RelMom, 1, 0) + IF(avg_Industrials_RelMom < avg_Healthcare_RelMom, 1, 0) + IF(avg_ITSector_RelMom < avg_Healthcare_RelMom, 1, 0) + IF(avg_Materials_RelMom < avg_Healthcare_RelMom, 1, 0) + IF(avg_Utilities_RelMom < avg_Healthcare_RelMom, 1, 0) + IF(avg_RealEstate_RelMom < avg_Healthcare_RelMom, 1, 0)) / 10
	xr_Industrials:	100 * (IF(avg_Comms_RelMom < avg_Industrials_RelMom, 1, 0) + IF(avg_ConsumerDisc_RelMom < avg_Industrials_RelMom, 1, 0) + IF(avg_ConsStaples_RelMom < avg_Industrials_RelMom, 1, 0) + IF(avg_Energy_RelMom < avg_Industrials_RelMom, 1, 0) + IF(avg_Financials_RelMom < avg_Industrials_RelMom, 1, 0) + IF(avg_Healthcare_RelMom < avg_Industrials_RelMom, 1, 0) + IF(avg_ITSector_RelMom < avg_Industrials_RelMom, 1, 0) + IF(avg_Materials_RelMom < avg_Industrials_RelMom, 1, 0) + IF(avg_Utilities_RelMom < avg_Industrials_RelMom, 1, 0) + IF(avg_RealEstate_RelMom < avg_Industrials_RelMom, 1, 0)) / 10
	xr_ITSector:	100 * (IF(avg_Comms_RelMom < avg_ITSector_RelMom, 1, 0) + IF(avg_ConsumerDisc_RelMom < avg_ITSector_RelMom, 1, 0) + IF(avg_ConsStaples_RelMom < avg_ITSector_RelMom, 1, 0) + IF(avg_Energy_RelMom < avg_ITSector_RelMom, 1, 0) + IF(avg_Financials_RelMom < avg_ITSector_RelMom, 1, 0) + IF(avg_Healthcare_RelMom < avg_ITSector_RelMom, 1, 0) + IF(avg_Industrials_RelMom < avg_ITSector_RelMom, 1, 0) + IF(avg_Materials_RelMom < avg_ITSector_RelMom, 1, 0) + IF(avg_Utilities_RelMom < avg_ITSector_RelMom, 1, 0) + IF(avg_RealEstate_RelMom < avg_ITSector_RelMom, 1, 0)) / 10
	xr_Materials:	100 * (IF(avg_Comms_RelMom < avg_Materials_RelMom, 1, 0) + IF(avg_ConsumerDisc_RelMom < avg_Materials_RelMom, 1, 0) + IF(avg_ConsStaples_RelMom < avg_Materials_RelMom, 1, 0) + IF(avg_Energy_RelMom < avg_Materials_RelMom, 1, 0) + IF(avg_Financials_RelMom < avg_Materials_RelMom, 1, 0) + IF(avg_Healthcare_RelMom < avg_Materials_RelMom, 1, 0) + IF(avg_Industrials_RelMom < avg_Materials_RelMom, 1, 0) + IF(avg_ITSector_RelMom < avg_Materials_RelMom, 1, 0) + IF(avg_Utilities_RelMom < avg_Materials_RelMom, 1, 0) + IF(avg_RealEstate_RelMom < avg_Materials_RelMom, 1, 0)) / 10
	xr_Utilities:	100 * (IF(avg_Comms_RelMom < avg_Utilities_RelMom, 1, 0) + IF(avg_ConsumerDisc_RelMom < avg_Utilities_RelMom, 1, 0) + IF(avg_ConsStaples_RelMom < avg_Utilities_RelMom, 1, 0) + IF(avg_Energy_RelMom < avg_Utilities_RelMom, 1, 0) + IF(avg_Financials_RelMom < avg_Utilities_RelMom, 1, 0) + IF(avg_Healthcare_RelMom < avg_Utilities_RelMom, 1, 0) + IF(avg_Industrials_RelMom < avg_Utilities_RelMom, 1, 0) + IF(avg_ITSector_RelMom < avg_Utilities_RelMom, 1, 0) + IF(avg_Materials_RelMom < avg_Utilities_RelMom, 1, 0) + IF(avg_RealEstate_RelMom < avg_Utilities_RelMom, 1, 0)) / 10
	xr_RealEstate:	100 * (IF(avg_Comms_RelMom < avg_RealEstate_RelMom, 1, 0) + IF(avg_ConsumerDisc_RelMom < avg_RealEstate_RelMom, 1, 0) + IF(avg_ConsStaples_RelMom < avg_RealEstate_RelMom, 1, 0) + IF(avg_Energy_RelMom < avg_RealEstate_RelMom, 1, 0) + IF(avg_Financials_RelMom < avg_RealEstate_RelMom, 1, 0) + IF(avg_Healthcare_RelMom < avg_RealEstate_RelMom, 1, 0) + IF(avg_Industrials_RelMom < avg_RealEstate_RelMom, 1, 0) + IF(avg_ITSector_RelMom < avg_RealEstate_RelMom, 1, 0) + IF(avg_Materials_RelMom < avg_RealEstate_RelMom, 1, 0) + IF(avg_Utilities_RelMom < avg_RealEstate_RelMom, 1, 0)) / 10
	rotX:	IF(SectorCodeRaw = 1, xr_Comms, IF(SectorCodeRaw = 2, xr_ConsumerDisc, IF(SectorCodeRaw = 3, xr_ConsStaples, IF(SectorCodeRaw = 4, xr_Energy, IF(SectorCodeRaw = 5, xr_Financials, IF(SectorCodeRaw = 6, xr_Healthcare, IF(SectorCodeRaw = 7, xr_Industrials, IF(SectorCodeRaw = 8, xr_ITSector, IF(SectorCodeRaw = 9, xr_Materials, IF(SectorCodeRaw = 10, xr_Utilities, IF(SectorCodeRaw = 11, xr_RealEstate, NaN)))))))))))
	rotXRaw:	IF(SectorCodeRaw = 1, avg_Comms_RelMom, IF(SectorCodeRaw = 2, avg_ConsumerDisc_RelMom, IF(SectorCodeRaw = 3, avg_ConsStaples_RelMom, IF(SectorCodeRaw = 4, avg_Energy_RelMom, IF(SectorCodeRaw = 5, avg_Financials_RelMom, IF(SectorCodeRaw = 6, avg_Healthcare_RelMom, IF(SectorCodeRaw = 7, avg_Industrials_RelMom, IF(SectorCodeRaw = 8, avg_ITSector_RelMom, IF(SectorCodeRaw = 9, avg_Materials_RelMom, IF(SectorCodeRaw = 10, avg_Utilities_RelMom, IF(SectorCodeRaw = 11, avg_RealEstate_RelMom, NaN)))))))))))
	rotDx3:	rotX - rotX[3]
	rotDx5:	rotX - rotX[5]
	rotDx10:	rotX - rotX[10]
	// ---- LAYER 37: per-symbol acceleration, his 3D / 5D / Intraday 3D / Gap 3D columns ----
	ret3:	IF(closev[3] > 0, 100 * (closev / closev[3] - 1), NaN)
	intra3:	100 * Sum(closev / openv - 1, 3)
	gap3:	100 * Sum(openv / closev[1] - 1, 3)
	momAccel3:	IF(momReady and not IsNaN(mom[3]), (mom - mom[3]) * 100, NaN)
	// ---- LAYER 38: ATR-unit trend position, DISPLAY ONLY, his Trend Filter position column ----
	// Nothing in the engine reads these. They only mirror his published Below -1.45 ATR style read.
	trueRng:	Max(highv, closev[1]) - Min(lowv, closev[1])
	atr14:	Avg(trueRng, 14)
	intra3Atr:	IF(atr14 > 0, Sum(closev - openv, 3) / atr14, NaN)
	gap3Atr:	IF(atr14 > 0, Sum(openv - closev[1], 3) / atr14, NaN)

ScanSettings:
	EndDate:	Latest
	// Latest bar only. Without this the scan writes one row per symbol
	// PER BAR across the whole imported history.
	NumBars:	1


Scan:
	// Every Scan column name below is deliberately DIFFERENT from the
	// Data item it reads. RealTest treats Scan columns as named items too
	// and rejects a name already used in Data, case-insensitively.
	// ---- identity ----
	// Every Scan column name below is deliberately DIFFERENT from the
	// Data item it reads. RealTest treats Scan columns as named items too
	// and rejects a name already used in Data, case-insensitively.
	// ---- identity ----
	Price:	closev
	Sector:	{?}	IF(SectorCodeRaw = 1, "Comms",
		IF(SectorCodeRaw = 2, "ConsumerDisc",
		IF(SectorCodeRaw = 3, "ConsStaples",
		IF(SectorCodeRaw = 4, "Energy",
		IF(SectorCodeRaw = 5, "Financials",
		IF(SectorCodeRaw = 6, "Healthcare",
		IF(SectorCodeRaw = 7, "Industrials",
		IF(SectorCodeRaw = 8, "ITSector",
		IF(SectorCodeRaw = 9, "Materials",
		IF(SectorCodeRaw = 10, "Utilities",
		IF(SectorCodeRaw = 11, "RealEstate",
		IF(SectorCodeRaw = 12, "Benchmark", IF(SectorCodeRaw = 13, "ETF", "Unclassified")))))))))))))
	SevRankPart:	sevRank
	SevPricePart:	sevPrice
	SevCandlePart:	sevCandle
	RankChg:	rankDelta
	PriceEvent:	{?}	IF(PriceTagCode = 1, "PRICE_DECLINE_5D",
		IF(PriceTagCode = 2, "PRICE_DECLINE_3D",
		IF(PriceTagCode = 3, "PRICE_ADVANCE_3D", "")))
	CandleEvent:	{?}	IF(CandleTagCode = 1, "INTRADAY_SELLING_3D",
		IF(CandleTagCode = 2, "BEARISH_CANDLE_BREADTH_3D",
		IF(CandleTagCode = 3, "WEAK_CLOSE_LOCATION_3D", "")))
	// ---- attention set, his M A G E S legend. NON-DIRECTIONAL. ----
	AttnMover:	attnM
	// ---- momentum and rotation ----
	MomShortPct:	momS
	MomMedPct:	momM
	MomLongPct:	mom
	MomAccelerate:	momAccel
	RelMomentum:	relMom
	RankRelMom:	relMomRank
	PctlRelMom:	relMomPctl
	// Named Delta rather than Accel so these never collide case-
	// insensitively with the accelRank / accelPctl Data items.
	DeltaRank:	accelRank
	DeltaPctl:	accelPctl
	PctlMove:	movePctl
	SectorRelMom:	mySectorRelMom
	sbCommsMom:	brd_Comms_Mom
	sbCommsAccel:	brd_Comms_Accel
	sbCommsRelMom:	brd_Comms_RelMom
	srmComms:	avg_Comms_RelMom
	sbConsumerDiscMom:	brd_ConsumerDisc_Mom
	sbConsumerDiscAccel:	brd_ConsumerDisc_Accel
	sbConsumerDiscRelMom:	brd_ConsumerDisc_RelMom
	srmConsumerDisc:	avg_ConsumerDisc_RelMom
	sbConsStaplesMom:	brd_ConsStaples_Mom
	sbConsStaplesAccel:	brd_ConsStaples_Accel
	sbConsStaplesRelMom:	brd_ConsStaples_RelMom
	srmConsStaples:	avg_ConsStaples_RelMom
	sbEnergyMom:	brd_Energy_Mom

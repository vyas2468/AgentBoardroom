	StartDate:	2015-01-01
	EndDate:	Latest
	// Yahoo-only. Strips a symbol's newest bar ONLY if its own exchange
	// session had not completed at import time -- documented as safe to
	// leave on for pre-open runs. NOT plain True, which blindly strips
	// every symbol's latest bar whether complete or not.
	RemoveLatest:	Partial
	SaveAs:	C:\RealTest21_newerv2\Data\alexaligned_unified_v7.rtd


Settings:
	DataFile:	C:\RealTest21_newerv2\Data\alexaligned_unified_v7.rtd
	BarSize:	Daily
	EndDate:	Latest
	AccountSize:	100000
	UseAvailableBars:	False
	SaveScanAs:	?scriptpath?\Outputs\AlexAligned_Unified_v7E_history.csv

	// StartDate lives in TestSettings only, exactly as in parts A B C: a StartDate in
	// Settings corrupts the ScanSettings EndDate Latest plus NumBars anchoring.
TestSettings:
	StartDate:	Earliest


Data:
	// raw daily prices, nothing else
	histOpenV:	O
	histHighV:	H
	histLowV:	L
	histCloseV:	C

ScanSettings:
	EndDate:	Latest
	// 280 bars, one row per symbol per bar. 252 trading days is one year; the extra
	// bars cover year-to-date in late December and the 12 month look-back with room.
	NumBars:	280


Scan:
	// Scan column names differ from the Data item names, as RealTest requires.
	HOpen:	histOpenV
	HHigh:	histHighV
	HLow:	histLowV
	HClose:	histCloseV

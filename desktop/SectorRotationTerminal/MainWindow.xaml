<Window x:Class="SectorRotationTerminal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Sector Rotation Terminal" Width="1440" Height="920"
        MinWidth="1024" MinHeight="700" Background="{StaticResource WindowBackground}"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="44" />
      <RowDefinition Height="*" />
      <RowDefinition Height="26" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource ChromeBackground}"
            BorderBrush="{StaticResource ChromeBorder}" BorderThickness="0,0,0,1">
      <DockPanel Margin="8,5">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button x:Name="HomeButton" Content="Home" Click="HomeButton_Click" ToolTip="Return to the terminal" />
          <Button x:Name="ReloadButton" Content="Reload" Click="ReloadButton_Click" ToolTip="Reload without deleting saved data" />
          <Button x:Name="DataFolderButton" Content="Data folder" Click="DataFolderButton_Click" ToolTip="Open local application data" />
        </StackPanel>
        <TextBlock Text="SECTOR ROTATION TERMINAL" Foreground="{StaticResource ChromeText}"
                   FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="8,0" />
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <wv2:WebView2 x:Name="TerminalView" />
      <Border x:Name="StartupOverlay" Background="#F51B1E23">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="480">
          <TextBlock Text="Sector Rotation Terminal" Foreground="{StaticResource ChromeText}"
                     FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock x:Name="StartupMessage" Text="Preparing the local terminal…"
                     Foreground="#A8AEB8" TextAlignment="Center" Margin="0,16,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource ChromeBackground}"
            BorderBrush="{StaticResource ChromeBorder}" BorderThickness="0,1,0,0">
      <TextBlock x:Name="StatusText" Text="Starting…" Foreground="#A8AEB8"
                 FontSize="11" VerticalAlignment="Center" Margin="12,0" />
    </Border>
  </Grid>
</Window>
